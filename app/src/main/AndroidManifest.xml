<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.midi" android:required="true" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 재설치 전에 만든 녹음을 목록에 보이기 위한 읽기 권한 (내가 만든 파일은 권한 없이 보임) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".PianoApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!--
            singleTask: 앱이 이미 떠 있을 때 피아노를 꽂으면 화면을 하나 더 만들지 않고 기존 화면으로 돌아간다.
            USB_DEVICE_ATTACHED: 피아노를 꽂으면 "이 앱으로 열기" 창 → "항상" 선택 시 이후 바로 실행.
            fullSensor: 폰의 "자동 회전" 설정과 무관하게 기울기대로 돌린다. USB를 꽂으면 폰을 옆으로 눕히게 되는데,
                        아이 폰은 자동 회전이 꺼져 있을 때가 많아서. (큰 화면 기기에서는 Android 16+가 이 값을 무시함)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
